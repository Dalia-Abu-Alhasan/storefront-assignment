# Copy to .env and fill in real values. .env is never committed.

# exchangerate-api.com — read server-side by app/api/rates/route.ts.
# Never prefix NEXT_PUBLIC_: that would inline the value into the browser bundle.
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here

# context7.com — used by the Context7 MCP server declared in .mcp.json.
# .mcp.json refers to it as ${CONTEXT7_API_KEY} and never holds the value.
# Claude Code expands that from the environment, not from .env, so this one also
# has to exist as a user environment variable:
#   Windows:      setx CONTEXT7_API_KEY "your_key"     (then restart Claude Code)
#   macOS/Linux:  export CONTEXT7_API_KEY="your_key"   (in your shell profile)
CONTEXT7_API_KEY=your_context7_api_key_here
